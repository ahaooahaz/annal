# Local package build: run makepkg -si from the packaging directory.
pkgname=pinmark
pkgver=0.3.0
pkgrel=1
pkgdesc='Native Wayland screenshot pinning with rectangle and arrow annotations'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('grim' 'slurp' 'wl-clipboard' 'gcc-libs' 'xdg-desktop-portal')
makedepends=('rust')
options=('!debug')

build() {
  cd "$startdir/.."
  CARGO_TARGET_DIR="$startdir/target" cargo build --release --locked --bin pinmark
}

check() {
  cd "$startdir/.."
  CARGO_TARGET_DIR="$startdir/target" cargo test --locked --all-targets
}

package() {
  install -Dm755 "$startdir/target/release/pinmark" "$pkgdir/usr/bin/pinmark"
  install -Dm644 "$startdir/pinmark.desktop" "$pkgdir/usr/share/applications/pinmark.desktop"
  install -Dm644 "$startdir/pinmark.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pinmark.svg"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/pinmark/LICENSE"
}
